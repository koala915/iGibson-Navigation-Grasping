# Generated / dependencies
node_modules/
.venv/
venv/
__pycache__/
*.py[cod]
.next/
dist/
build/
.cache/

# Agent/IDE local hidden folders
.agents/
.claude/
.codebase-memory/

# Local secrets
.env
.env.*
*.pem
*.key
*.p12
*.pfx

# Large binary/media artifacts
*.mp3
*.mp4
*.mov
*.avi
*.mkv
*.7z
*.rar
*.pt
*.pth
*.onnx
*.ckpt

# Exclude torch weights by default except the YOLO models the project ships.
# Each is ~5 MB, well under GitHub's limits -- no LFS needed.
# (*.pt.bak rollback copies are not matched by *.pt, so they track as-is.)
!detection/models/*.pt
!yolo/**/*.pt

# The release-branch drop-in: 205 MB, and 204 MB of it is a second copy of the
# meshes already in grasp/x3plus/. Its one unique file is kept, labelled, at
# grasp/v21/reference/ -- that is the provenance record for the ported release.
# Ignored rather than deleted so nobody loses it by accident, but it must never
# reach the repo: a `git add -A` would push 205 MB of duplicates.
/training/
/README.txt

# Handoff archives are built artifacts; rebuild them, do not version them.
/handoff_build/

# Competition paperwork: drafts, the submitted entry, and a third-party sample
# SRS. This repo is public and the entry is the team's, not the code's, so it
# stays local. document/build_srs.py builds the .docx from the Markdown source,
# which is what makes the .docx safe to drop rather than version.
/document/

# The operator-console report is generated from ui/ and its screenshots. The
# screenshots themselves ARE tracked, at docs/images/ui/ -- the README uses
# them -- but the ~1 MB .docx/.pdf rebuild from those and do not belong here.
/ui/report_output/

# Run logs. Four mode-B bridge transcripts used to be committed at the root;
# they are captured output, not source, and they made the root look like a
# scratch directory.
*.log

# Exclude zip by default except trained models.
# This rule fails SILENTLY: git status never mentions a model you forgot to
# except, so a "committed" model pair can be missing on the next clone. After
# adding a model, confirm the .zip really appears in `git show --stat`.
*.zip
!grasp/trained_6d_models_v17/*.zip
!grasp/trained_6d_models_v18/*.zip
!grasp/v21/models/*.zip
!grasp/v23/models/*.zip
!grasp/v24/models/*.zip
!integration/nav_best_model/*.zip

# The v23 delivery package is 205 MB of meshes and a copy of the controller --
# it is built from the tree, not authored here. Ship it out of band.
grasp/deploy_v23/
