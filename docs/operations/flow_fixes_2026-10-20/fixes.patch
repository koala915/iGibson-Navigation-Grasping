+    def pose_for_frame(self, stamp):
+        """A map pose only when capture through inference is known stationary.
+
+        The RTP stream has no shared camera/AMCL timestamp. Do not pretend a
+        current pose matches a moving frame: withhold map filtering and park.
+        Include the stream latency bound and pose freshness allowance before
+        the decoded frame; reject missing coverage, movement and sample gaps.
+        """
+        now = self.clock()
+        if not math.isfinite(stamp) or stamp > now or now - stamp > STREAM_STALE_S:
+            return None
+        with self.lock:
+            if (self.pose_at is None or now - self.pose_at > POSE_MAX_AGE_S
+                    or not self.pose_history):
+                return None
+            history = list(self.pose_history)
+        since = stamp - STREAM_LATENCY_S - POSE_MAX_AGE_S
+        anchors = [i for i, (at, _pose) in enumerate(history) if at <= since]
+        if not anchors:
+            return None
+        history = history[anchors[-1]:]
+        at, pose = history[-1]
+        if now - at > POSE_MAX_AGE_S:
+            return None
+        for i, (sample_at, sample) in enumerate(history):
+            if i and not 0 <= sample_at - history[i - 1][0] <= POSE_MAX_AGE_S:
+                return None
+            if (math.hypot(sample[0] - pose[0], sample[1] - pose[1]) > FRAME_STILL_M
+                    or abs(dock.wrap(sample[2] - pose[2])) > FRAME_STILL_RAD):
+                return None
+        return pose
 
